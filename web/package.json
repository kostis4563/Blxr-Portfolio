{
  "name": "@blxr/web",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "vite build && npm run build:report",
    "build:report": "vite build --config vite.report.config.js",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist-ssr --emptyOutDir",
    "prerender": "node prerender.js",
    "compress": "node compress.js",
    "build": "npm run build:client && npm run build:server && npm run prerender && npm run compress",
    "build:protected": "OBFUSCATE=1 npm run build:client && npm run build:server && npm run prerender && npm run compress",
    "preview": "vite preview",
    "test": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.js",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "javascript-obfuscator": "^5.9.0",
    "marked": "^18.1.1",
    "shiki": "^4.5.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
