# Supabase → Project Settings → API Keys. Both are meant for the browser;
# copy this file to .env.local (gitignored) and fill them in before `npm run build`.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional, dev only. `npm run dev` forwards /api to https://blxr.net; point it
# at a local `npm start --workspace server` instead, or set it empty to turn it off.
# VITE_API_PROXY=http://127.0.0.1:8899
