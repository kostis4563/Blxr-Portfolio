# Supabase → Project Settings → API Keys. Both are meant for the browser;
# copy this file to .env.local (gitignored) and fill them in before `npm run build`.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# VITE_TURNSTILE_SITE_KEY=0x4AAAAAAA...   optional Turnstile captcha on the login forms; secret goes in Supabase
